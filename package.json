{
  "name": "traceorb-node",
  "version": "0.5.1",
  "description": "Traceorb ingest SDK for Node.js",
  "license": "MIT",
  "author": "Eduardo De Patta",
  "homepage": "https://traceorb.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraceOrb/obs-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/TraceOrb/obs-sdk-node/issues"
  },
  "keywords": [
    "traceorb",
    "observability",
    "nodejs",
    "express",
    "fastify",
    "middleware",
    "http",
    "request-tracing",
    "apm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "smoke": "npm run build && node scripts/smoke-ingest.mjs",
    "version:major": "npm version major && git push origin HEAD --follow-tags",
    "version:minor": "npm version minor && git push origin HEAD --follow-tags",
    "version:patch": "npm version patch && git push origin HEAD --follow-tags"
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.1.0",
    "fastify": "^5.12.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
